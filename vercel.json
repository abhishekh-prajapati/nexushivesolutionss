{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/data/:filename", "destination": "/api/data.js?file=:filename" },
    { "source": "/api/save", "destination": "/api/save.js" },
    { "source": "/api/upload-image", "destination": "/api/upload-image.js" },
    { "source": "/api/verify", "destination": "/api/verify.js" },
    { "source": "/home", "destination": "/" },
    { "source": "/card", "destination": "/card.html" },
    { "source": "/digital-card", "destination": "/card.html" },
    { "source": "/vcard", "destination": "/card.html" },
    { "source": "/jaya-bhavya", "destination": "/card.html" }
  ]
}
