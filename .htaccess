Options -Indexes
RewriteEngine On

# -------------------------------------------------------
# Clean URLs: redirect *.html to extensionless, rewrite extensionless to *.html
# -------------------------------------------------------

# Redirect index.html to clean root
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect other .html files to clean URL
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Map /home to serve index.html internally
RewriteRule ^home$ index.html [L]

# Digital card aliases
RewriteRule ^(card|digital-card|vcard|bhavya|jaya-bhavya)$ card.html [L]

# Internally rewrite clean URLs to .html files if they exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# -------------------------------------------------------
# NexusHive CMS API Routes (MilesWeb / Apache shared hosting)
# Routes clean API URLs to their PHP handler files
# -------------------------------------------------------

# GET /api/data/:filename  →  php/data.php?file=:filename
RewriteRule ^api/data/([a-zA-Z0-9_\-]+\.json)$ php/data.php?file=$1 [QSA,L]

# POST /api/save  →  php/save.php
RewriteRule ^api/save$ php/save.php [QSA,L]

# POST /api/upload-image  →  php/upload-image.php
RewriteRule ^api/upload-image$ php/upload-image.php [QSA,L]

# -------------------------------------------------------
# Security: block direct access to raw data files
# -------------------------------------------------------
<FilesMatch "\.(json)$">
    <IfModule mod_rewrite.c>
        RewriteCond %{REQUEST_URI} ^/data/
        RewriteRule .* - [F,L]
    </IfModule>
</FilesMatch>

# Block access to server config files
<FilesMatch "(^\.htaccess|server\.js|package\.json|vercel\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>
